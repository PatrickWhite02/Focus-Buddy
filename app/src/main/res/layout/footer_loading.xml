<?xml version="1.0" encoding="utf-8"?>
<!-- The "Loading apps" block shown at the end of the picker's list while the app scan runs.
     Its height is set in AppPickerActivity so it fills the space the apps will take up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">

    <ProgressBar
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:indeterminate="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/super_frog"
        android:text="Loading apps…"
        android:textColor="@color/primary_dark"
        android:textSize="32sp" />
</LinearLayout>
