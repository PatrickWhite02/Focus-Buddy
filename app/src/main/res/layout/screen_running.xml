<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="LinearLayout">

    <!-- Shown when ready and idle -->
    <LinearLayout
        android:id="@+id/startGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical|center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etHours"
                android:layout_width="69dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/super_frog"
                android:gravity="bottom|center_horizontal"
                android:hint="Session length (hours)"
                android:inputType="numberDecimal"
                android:text="3"
                android:textColor="@color/primary"
                android:textSize="50dp" />
            <TextView
                style="@style/BaseButtonStyle"
                android:text="Hours (Decimal permitted)"
                />

        </LinearLayout>

        <Button
            android:id="@+id/btnChooseApps"
            style="@style/BaseButtonStyle"
            android:text="Choose what to block"
            />

        <Button
            android:id="@+id/btnSchedule"
            style="@style/BaseButtonStyle"
            android:text="Scheduled sessions"
            />

        <Button
            android:id="@+id/btnStart"
            style="@style/BaseButtonStyle"
            android:text="Start focus session"
            />

        <Button
            android:id="@+id/btnUntilScan"
            style="@style/BaseButtonStyle"
            android:text="Block until QR scan"
            />
    </LinearLayout>

    <!-- Shown while a session is running -->
    <LinearLayout
        android:id="@+id/activeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:fontFamily="@font/super_frog"
            android:textSize="48sp" />

        <Button
            android:id="@+id/btnScan"
            style="@style/BaseButtonStyle"
            android:text="Scan QR to end session" />
    </LinearLayout>
</merge>
