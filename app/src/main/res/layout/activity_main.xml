<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/activity_background">

        <!-- MainActivity: the options screen -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/super_frog"
            android:text="@string/app_name"
            android:textColor="@color/primary_dark"
            android:textSize="55sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:fontFamily="@font/super_frog"
            android:textSize="16sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etHours"
                android:layout_width="69dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/super_frog"
                android:gravity="bottom|center_horizontal"
                android:hint="Session length (hours)"
                android:inputType="numberDecimal"
                android:text="3"
                android:textColor="@color/primary"
                android:textSize="50dp" />
            <TextView
                style="@style/BaseButtonStyle"
                android:text="Hours (Decimal permitted)"
                />

        </LinearLayout>

        <Button
            android:id="@+id/btnChooseApps"
            style="@style/BaseButtonStyle"
            android:text="Choose what to block"
            />

        <Button
            android:id="@+id/btnSchedule"
            style="@style/BaseButtonStyle"
            android:text="Scheduled sessions"
            />

        <Button
            android:id="@+id/btnStart"
            style="@style/BaseButtonStyle"
            android:text="Start focus session"
            />

        <Button
            android:id="@+id/btnUntilScan"
            style="@style/BaseButtonStyle"
            android:text="Block until QR scan"
            />
    </LinearLayout>
</LinearLayout>
