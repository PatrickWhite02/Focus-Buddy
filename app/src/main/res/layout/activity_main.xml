<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/activity_background">

        <!-- MainActivity: the options screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="55sp"
                android:autoSizeMinTextSize="30sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/super_frog"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/primary_dark"
                android:textSize="55sp" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Shown while nothing is selected to block -->
        <TextView
            android:id="@+id/tvNoApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/warning_banner"
            android:fontFamily="@font/super_frog"
            android:gravity="center"
            android:padding="16dp"
            android:text="No apps or websites selected to block! Open Settings (the gear, top right) and choose what to block."
            android:textColor="@color/white"
            android:textSize="20sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:fontFamily="@font/super_frog"
            android:textSize="16sp" />

        <!-- Only while a session is running: the countdown, or when the block lifts -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/super_frog"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/primary_dark"
            android:textSize="48sp"
            android:visibility="gone" />

        <!-- Only while a timed session is running: the clock time the countdown reaches -->
        <TextView
            android:id="@+id/tvSessionEnds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/super_frog"
            android:gravity="center"
            android:paddingBottom="24dp"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- Hidden unless a scheduled block is coming up -->
        <TextView
            android:id="@+id/tvNextBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/super_frog"
            android:textColor="@color/primary_dark"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Unticking skips just that upcoming block; the schedule itself is kept -->
        <CheckBox
            android:id="@+id/cbNextEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:checked="true"
            android:text="Enable"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSchedule"
            style="@style/BaseButtonStyle"
            android:layout_marginTop="24dp"
            android:text="Scheduled sessions"
            />

        <!-- "Extend session" while a session is running -->
        <Button
            android:id="@+id/btnStart"
            style="@style/BaseButtonStyle"
            android:layout_marginTop="24dp"
            android:text="Start focus session"
            />

        <!-- Only while a session is running -->
        <Button
            android:id="@+id/btnScan"
            style="@style/BaseButtonStyle"
            android:layout_marginTop="24dp"
            android:text="Scan QR to end session"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
