<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseButtonStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/base_button_shape</item>
        <item name="android:fontFamily">@font/super_frog</item>
        <item name="android:gravity">center_vertical|center_horizontal</item>
        <!-- Side padding keeps text off the rounded edges (the text shrinks to fit inside it),
             and one line means it shrinks instead of wrapping -->
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:maxLines">1</item>

        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">14sp</item>
        <item name="android:autoSizeMaxTextSize">30sp</item>
        <item name="android:autoSizeStepGranularity">5sp</item>
    </style>

    <!-- Put on a view with android:theme to give it the app's purple instead of the system's
         green accent (checkbox tick, text cursor, selection highlight, clock hand) -->
    <style name="PurpleControls">
        <item name="android:colorAccent">@color/primary_dark</item>
        <item name="android:colorControlActivated">@color/primary_dark</item>
    </style>

    <!-- The "Block until" clock: no coloured header bar, purple title-style time text -->
    <style name="FocusTimePicker" parent="@android:style/Widget.Material.Light.TimePicker">
        <item name="android:headerBackground">@android:color/transparent</item>
        <item name="android:headerTimeTextAppearance">@style/FocusClockHeaderText</item>
        <item name="android:headerAmPmTextAppearance">@style/FocusClockAmPmText</item>
        <item name="android:numbersTextColor">@color/clock_numbers_text</item>
        <item name="android:numbersBackgroundColor">#66D0BCFF</item>
        <item name="android:numbersSelectorColor">@color/primary_dark</item>
    </style>

    <style name="FocusClockHeaderText">
        <item name="android:fontFamily">@font/super_frog</item>
        <item name="android:textSize">56sp</item>
        <item name="android:textColor">@color/clock_header_text</item>
    </style>

    <style name="FocusClockAmPmText">
        <item name="android:fontFamily">@font/super_frog</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/clock_header_text</item>
    </style>

    <!-- The scheduler's start/end time pop-ups: the same purple clock as the Start session screen -->
    <style name="FocusTimePickerDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/primary_dark</item>
        <item name="android:colorControlActivated">@color/primary_dark</item>
        <item name="android:timePickerStyle">@style/FocusTimePicker</item>
    </style>
</resources>